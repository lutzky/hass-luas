#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if command -v uv >/dev/null 2>&1; then
    if [ ! -x .venv/bin/python ]; then
        rm -rf .venv
        uv venv --python 3.13 --seed .venv
    fi
    .venv/bin/python -m pip install --requirement requirements.txt
else
    python3 -m pip install --requirement requirements.txt
fi
