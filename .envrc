# Modern Python environment managed with uv + direnv.
#
# `layout pyenv`/`layout python3` from direnv would rely on pyenv or a bare
# system Python and would not install this project's dependencies, so we
# bootstrap a dedicated .venv with uv instead. If you prefer the simpler
# direnv-native form, `layout python3` works too, but run `scripts/setup`
# afterwards to install requirements.txt.
if [ ! -x .venv/bin/python ]; then
    rm -rf .venv
    uv venv --python 3.13 --seed .venv
    .venv/bin/python -m pip install --requirement requirements.txt
fi

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"
